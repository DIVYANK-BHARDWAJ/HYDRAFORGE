# HYDRAFORGE Production Environment Configuration Template
# Database URL: Supports PostgreSQL (e.g. Neon, AWS RDS) or local SQLite
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
# Alternative for local SQLite:
# DATABASE_URL=sqlite:///data/hydraforge.db

# Flask and API Security
HYDRAFORGE_SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-key
HYDRAFORGE_ORGANIZER_USER=organizer
HYDRAFORGE_ORGANIZER_PASS=basinshift2026organizer
HYDRAFORGE_ORGANIZER_KEY=organizer_master_key_hydraforge_basinshift_2026

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Worker Configuration
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=2.0
LEASE_TIMEOUT_SECONDS=300
MAX_JOB_RETRIES=3

# Dataset and Execution Isolation
CARAVAN_DATA_ROOT=data/caravan
EXECUTION_BACKEND=docker
DOCKER_NETWORK=none
DOCKER_MEMORY_LIMIT=4g
DOCKER_CPU_LIMIT=2.0
TIMEOUT_SECONDS=300

